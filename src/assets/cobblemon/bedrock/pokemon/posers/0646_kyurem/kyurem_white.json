{
  "portraitScale": 1.12,
  "portraitTranslation": [-1.7, 5.7, 0],
  "profileScale": 0.21,
  "profileTranslation": [0.07, 1.49, -20],
  "thirdPersonCameraOffset": {
    "seat_1": [0, 2, 5],
    "seat_1_reverse": [0, 0.45, 1]
  },
  "thirdPersonCameraOffsetNoViewBobbing": {
    "seat_1": [0, 2, 5],
    "seat_1_reverse": [0, 0.45, 1]
  },
  "animations": {
   

  },
  "poses": {
    "battle-standing": {
      "transformTicks": 10,
      "poseTypes": ["STAND", "WALK"],
      "condition": "!q.in_air && !q.is_sprinting",
      "isBattle": true,
      "animations": [
        "q.look('head_ai')",
        "q.bedrock('kyurem_white', 'battle_idle')"
      ]
    },
    "standing": {
      "transformTicks": 10,
      "poseTypes": ["STAND", "NONE", "PORTRAIT", "PROFILE"],
      "condition": "!q.in_air" ,
      "isBattle": false,
      "animations": [
        "q.look('head_ai')",
        "q.bedrock('kyurem_white', 'ground_idle')"
      ]
    },
    "walking": {
      "transformTicks": 8,
      "poseTypes": ["WALK"],
      "condition": "!q.in_air && !q.is_sprinting",
      "animations": [
        "q.look('head_ai')",
        "q.bedrock('kyurem_white', 'ground_walk')"
      ]
    },
     "in-air": {
        "poseTypes": ["STAND", "WALK"],
        "isBattle": false,
        "condition": "q.in_air && q.is_ridden",
        "animations": ["q.look('head_ai')","q.bedrock('kyurem_white', 'ride_jump')"],
        "transformTicks": 2,
        "transformToTicks": 2
      },
    "hover": {
      "transformTicks": 5,
      "condition": "!q.in_air && !q.is_sprinting",
      "poseTypes": ["HOVER", "FLOAT" ],
      "animations": [
        "q.look('head_ai')",
        "q.bedrock('kyurem_white', 'air_idle')"
       ]
    },
    "fly": {
      "transformTicks": 5,
      "condition": "!q.is_sprinting",
      "poseTypes": [ "FLY" ],
      "animations": [
        "q.look('head_ai')",
        "q.bedrock('kyurem_white', 'air_fly')"
       ]
    },
    "float": {
      "transformTicks": 5,
      "condition": "!q.is_sprinting",
      "poseTypes": ["FLOAT"],
      "animations": [
        "q.look('head_ai')",
        "q.bedrock('kyurem_white', 'air_idle')"
      ]
    },
    "swim": {
      "transformTicks": 8,
      "poseTypes": ["SWIM"],
      "condition": "!q.is_sprinting",
      "animations": [
        "q.look('head_ai')",
        "q.bedrock('kyurem_white', 'ground_walk')"
      ]
    },
    "run": {
        "poseTypes": ["STAND","WALK"],
        "isBattle": false,
        "condition": "!q.in_air && q.is_sprinting",
        "animations": [
         "q.look('head_ai')",
          "q.bedrock('kyurem_white', 'ground_run')",
        {
          "condition": "q.is_ridden",
          "animation": "q.bedrock('kyurem_white', 'ride_ground_run')"
        }
        ],
        "transformTicks": 10
      }
  }
}